{
  "name": "@monad/publication-site",
  "version": "0.3.0",
  "private": true,
  "description": "The documentation and engineering-log publication site for Monad.",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun run scripts/dev.mjs",
    "build": "bun run content:sync && bun --bun next build",
    "start": "bun --bun next start",
    "clean": "bun run scripts/clean.mjs",
    "content:sync": "bun run scripts/content/sync.mjs",
    "content:validate": "bun run scripts/content/sync.mjs --check",
    "content:validate:strict": "bun run scripts/content/sync.mjs --check --strict",
    "content:clean": "bun run scripts/content/clean.mjs",
    "content:report": "bun run scripts/content/report.mjs",
    "typegen": "fumadocs-mdx",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "check": "biome check .",
    "typecheck": "bun run content:sync && bun run typegen && tsc --noEmit",
    "test": "bun run test:unit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install --with-deps chromium",
    "verify": "bun run content:validate && bun run check && bun run typecheck && bun run test:unit && bun run build",
    "verify:strict": "bun run content:validate:strict && bun run check && bun run typecheck && bun run test:unit && bun run build",
    "verify:full": "bun run verify && bun run test:e2e"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "fumadocs-core": "16.14.0",
    "fumadocs-mdx": "15.2.2",
    "fumadocs-ui": "16.14.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.2.0",
    "@types/mdx": "2.0.13",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "4.1.10",
    "postcss": "^8.5.6",
    "tailwindcss": "4.2.0",
    "typescript": "^5.9.3",
    "vitest": "4.1.10"
  }
}
