# Canonical public URL used to construct absolute metadata URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional public repository URL. Leave blank until the canonical remote is final.
NEXT_PUBLIC_REPOSITORY_URL=

# Optional explicit Monad repository root. Normally Git discovery or ../../ is sufficient.
# MONAD_REPOSITORY_ROOT=/absolute/path/to/monad

# Derived publication exports
MONAD_EDITION_EXPORT_ENABLED=true
MONAD_EDITION_EXPORT_SECRET=
MONAD_EDITION_VERSION=continuous

# Deployment and operational identity
MONAD_DEPLOYMENT_TARGET=local
MONAD_BUILD_COMMIT=
MONAD_BUILD_VERSION=continuous
MONAD_BUILD_CHANNEL=development

# Enable HSTS only when the public site is exclusively served over HTTPS.
MONAD_SECURITY_HSTS=false

# Optional health-check details. Never put secrets in these values.
MONAD_DEPLOYMENT_REGION=
